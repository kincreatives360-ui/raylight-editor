{
  "name": "@reverse-engineer/cli",
  "version": "1.0.0",
  "description": "Reverse engineer any web app to 1-to-1 parity — evidence-driven toolkit for capturing, analyzing, and rebuilding interfaces",
  "type": "commonjs",
  "bin": {
    "reverse-engineer": "./scripts/cli.js",
    "recon": "./scripts/recon.js",
    "inventory": "./scripts/dom_inventory.cjs",
    "sweep": "./scripts/interaction_sweep.cjs",
    "summarize": "./scripts/summarize_inventory.py",
    "tokens": "./scripts/extract_tokens.py",
    "diff": "./scripts/diff_inventories.py",
    "lint-cards": "./scripts/lint_cards.py",
    "visual-diff": "./scripts/visual_diff.js",
    "a11y": "./scripts/a11y_walk.cjs",
    "fingerprint": "./scripts/fingerprint_stack.py",
    "har-to-contracts": "./scripts/har_to_contracts.py",
    "har-to-msw": "./scripts/har_to_msw.py",
    "unpack-extension": "./scripts/unpack_extension.py",
    "scaffold": "./scripts/scaffold_workspace.js",
    "save-auth": "./scripts/save_auth.js",
    "doctor": "./scripts/doctor.js",
    "run-agent": "./scripts/run_agent.js",
    "generate-tests": "./scripts/generate_tests.py",
    "theme-tokens": "./scripts/theme_tokens.py",
    "inspect-canvas": "./scripts/inspect_canvas.py",
    "inspect-extension": "./scripts/inspect_extension.py",
    "capture-websocket": "./scripts/capture_websocket.py",
    "enforce-budget": "./scripts/enforce_budget.py"
  },
  "scripts": {
    "install:playwright": "npx playwright install chromium",
    "doctor": "node scripts/doctor.js",
    "check": "node scripts/doctor.js"
  },
  "keywords": [
    "reverse-engineering",
    "web-app",
    "parity",
    "playwright",
    "design-tokens",
    "component-analysis",
    "visual-regression"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "playwright": "^1.44.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {},
  "files": [
    "scripts/**/*",
    "assets/**/*",
    "references/**/*",
    "evals/**/*",
    "SKILL.md",
    "README.md"
  ]
}